# Public origin of this app. It must exactly match the Authentik redirect URI origin.
# In development the browser uses Vite on 5173; production should use its public HTTPS origin.
APP_URL=http://localhost:5173
PORT=3000

DATABASE_URL=postgresql://profile:profile@localhost:5432/profile
AVATAR_DIR=./data/avatars
MAX_UPLOAD_BYTES=5242880

# Use the per-provider issuer shown by Authentik, including its trailing slash.
OIDC_ISSUER=https://auth.example.com/application/o/profile/
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me

# Generate with: openssl rand -base64 48
COOKIE_SECRET=replace-me
SESSION_TTL_DAYS=7
