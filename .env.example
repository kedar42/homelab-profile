# Public origin of this app. It must exactly match the Authentik redirect URI origin.
# In development the browser uses Vite on 5173; production should use its public HTTPS origin.
APP_URL=http://localhost:5173
PORT=3000

# Embedded SQLite is the zero-service local default.
DATABASE_DRIVER=sqlite
SQLITE_DATABASE_PATH=./data/profile.sqlite
# For PostgreSQL development/production instead:
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgresql://profile:profile@localhost:5432/profile
AVATAR_DIR=./data/avatars
MAX_UPLOAD_BYTES=5242880

# Development entry only. This never bypasses database sessions, CSRF, or avatar processing.
# Production startup refuses to run while this is true.
DEV_AUTH_ENABLED=true
DEV_AUTH_SUBJECT=local-developer
DEV_AUTH_USERNAME=developer
DEV_AUTH_DISPLAY_NAME=Local Developer
DEV_AUTH_EMAIL=developer@localhost
# DEV_AUTH_PICTURE_URL=https://example.com/avatar.png

# Use the per-provider issuer shown by Authentik, including its trailing slash.
# These placeholders are not contacted while DEV_AUTH_ENABLED=true.
OIDC_ISSUER=https://auth.example.com/application/o/profile/
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me

# Local authentication substitutes a development-only secret while this remains "replace-me".
# Real OIDC development and production require: openssl rand -base64 48
COOKIE_SECRET=replace-me
SESSION_TTL_DAYS=7
