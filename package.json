{
  "name": "homelab-profile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --watch src/dev.ts",
    "dev:web": "vite",
    "start": "bun src/index.ts",
    "build": "vite build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "quality": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run quality && bun run typecheck && bun test && bun run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@elysia/eden": "1.4.10",
    "@elysia/openapi": "1.4.15",
    "@elysia/static": "1.4.11",
    "@gravity-ui/icons": "2.22.0",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.30",
    "elysia-rate-limit": "4.6.2",
    "openid-client": "6.8.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
